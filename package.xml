<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dvrk_utils</name>
  <version>0.1.0</version>
  <description>Utilities for controlling arm topics and TF helpers in ROS 2.</description>
  <maintainer email="sxy841@case.edu">erie_lab</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <exec_depend>crtk_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-aiohttp</exec_depend>
  <exec_depend>python3-qrcode</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-gi</exec_depend>
  <exec_depend>gir1.2-gtk-3.0</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
